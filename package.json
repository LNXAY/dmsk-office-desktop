{
    "name": "dmsk-office",
    "productName": "DMSK Office",
    "version": "1.1.0",
    "description": "DMSK Office als Windows-Programm",
    "main": "main.js",
    "author": "DMSK Media",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win nsis"
    },
    "build": {
        "appId": "de.dmsk-media.office",
        "productName": "DMSK Office",
        "copyright": "DMSK Media",
        "files": [
            "main.js",
            "offline.html",
            "icons/**"
        ],
        "extraResources": [],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "DMSK Office",
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico"
        },
        "artifactName": "DMSK-Office-Setup.exe",
        "afterPack": "build/afterPack.js",
        "publish": [
            {
                "provider": "generic",
                "url": "https://raw.githubusercontent.com/LNXAY/dmsk-office-desktop/main/releases/"
            }
        ]
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "rcedit": "^5.0.2"
    },
    "dependencies": {
        "electron-updater": "^6.3.9"
    }
}